{
  "name": "noted-server",
  "version": "1.0.0",
  "description": "Noted private sync backend (Cloudflare Worker)",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
